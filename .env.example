# Neon (Postgres). Copiar la connection string POOLED del dashboard de Neon,
# la que tiene "-pooler" en el host.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Secreto para firmar las sesiones (JWT). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
