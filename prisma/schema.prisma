// Balanz — esquema de datos
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum PlanBucket {
  ESENCIAL
  OCIO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  debt         Debt?
  planSettings PlanSettings?
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  color     String       @default("#64748b") // hex, para los graficos
  icon      String       @default("wallet") // nombre del icono de lucide-react
  createdAt DateTime     @default(now())

  // Null = usar bucketSugerido() por nombre (src/lib/plan-distribucion.ts). Se
  // completa la primera vez que el usuario toca el toggle Esencial/Ocio en
  // /plan, y desde ahi queda fijo hasta que lo cambie de nuevo.
  planBucket PlanBucket?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budget       Budget?

  @@unique([userId, name, kind])
  @@index([userId])
}

model Transaction {
  id String @id @default(cuid())

  userId     String
  categoryId String?

  // La plata se guarda en centavos (entero) para no arrastrar errores de punto flotante.
  amountCents Int
  type        CategoryKind
  description String

  // Solo importa el dia. Se guarda siempre a medianoche UTC y se lee con getters UTC
  // (ver src/lib/date.ts) para que no se corra un dia segun la zona horaria.
  date DateTime

  // Lo calcula el motor de recomendaciones, no lo carga el usuario.
  isRecurringGuess Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryId])
}

model Budget {
  id                String   @id @default(cuid())
  userId            String
  categoryId        String   @unique
  monthlyLimitCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Una deuda por usuario (por ahora). originalCents queda fijo como referencia
// de cuanto se debia al arrancar; remainingCents baja con cada pago
// registrado, hasta llegar a 0.
model Debt {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String   @default("Deuda")
  originalCents  Int
  remainingCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Lo que el usuario tipeo en /plan la ultima vez, para que no se pierda al
// recargar la pagina. incomeCents null = seguir usando el ingreso real del
// mes en vez de un monto fijado a mano.
model PlanSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  incomeCents            Int?
  porcentajeEsencial     Int      @default(50)
  porcentajeOcio         Int      @default(30)
  porcentajeAhorro       Int      @default(20)
  deudaPagoPlaneadoCents Int      @default(0)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
